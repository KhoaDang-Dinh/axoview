{
  "name": "axoview-app",
  "version": "3.7.0",
  "private": true,
  "description": "Progressive Web App for creating isometric diagrams",
  "dependencies": {
    "@axoview/collaboration": "file:../axoview-collaboration",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@isoflow/isopacks": "^0.0.10",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@react-oauth/google": "^0.13.5",
    "axoview": "*",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-http-backend": "^4.0.10",
    "jszip": "^3.10.2",
    "lib0": "^0.2.120",
    "react": "^19.3.1",
    "react-arborist": "^4.0.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^18.0.1",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.18.5",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.33",
    "zustand": "^5.1.0"
  },
  "scripts": {
    "prebuild": "node scripts/generateMaterialIconPack.js && cd ../.. && npm run build:lib",
    "prestart": "node scripts/generateMaterialIconPack.js && node ../../scripts/build-public-docs.mjs",
    "start": "rsbuild dev",
    "build": "node ../../scripts/build-public-docs.mjs && rsbuild build",
    "preview": "rsbuild preview",
    "preview:r1": "node scripts/preview-r1.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "clean": "rm -rf build",
    "lint": "tsc --noEmit",
    "test": "npx --no-install jest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.2",
    "@rsbuild/plugin-react": "^2.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "core-js": "^3.51.0"
  }
}
